{
  // gulp endpoint configuration
  "gulp": {
    // gulp host::port
    "uri": "http://localhost:8080",
    // gulp username
    "username": "admin",
    // gulp password
    "password": "admin",
    // gulp operation id to ingest data under
    "operation_id": "test_operation",
    // if set and uri uses https, whether to use client certificates for mutual TLS authentication with gulp
    // certificates must be provided in ./certs/ directory as slurp.pem, slurp-key.pem (without password), ca.pem
    "use_certs": false,
    // whether to skip TLS verification when connecting to gulp over https
    "skip_tls_verify": true
  },
  // maximum chunk size for data ingestion (data is buffered then flushed every 15 seconds or when this size is reached)  
  "max_chunk_size": 1000,
  // the hooks to be installed, supported hooks are "proc_exec" (process execution), "conn_outbound" (outbound connections), "conn_inbound" (inbound connections), "login" (login events). if empty, all hooks are installed
  "hooks": [],
  // list of patterns to exclude events by "process.name", supports wildcards. if empty, no exclusion is performed
  "process_exclude": [],
  // list of patterns to exclude events by parent process "process.parent_name", supports wildcards. if empty, no exclusion is performed
  "process_parent_exclude": [],
  // list of patterns to include events by "process.name", supports wildcards. if empty, no inclusion filtering is performed
  "process_include": []
  ,
  // list of numeric destination ports to include. if empty, no dst-port inclusion filtering is performed
  "dst_port_include": [],
  // list of numeric destination ports to exclude. if empty, no dst-port exclusion is performed
  "dst_port_exclude": [],
  // list of source ip addresses (ipv4 or ipv6) to include. if empty, no src-ip inclusion filtering is performed
  "src_ip_include": [],
  // list of source ip addresses (ipv4 or ipv6) to exclude. if empty, no src-ip exclusion is performed
  "src_ip_exclude": []
}
